# Gemini API key used for the "repair" stage (semantic SVG cleanup).
# Users may also supply their own key from the UI (see hooks/useLocalStorage.ts).
GEMINI_API_KEY=

# Pollinations API key (sk_...) used for the text-to-image ("Describe") and
# image-to-image ("Describe changes") features. Get one at enter.pollinations.ai.
# Server-only — never exposed to the browser (see lib/ai/pollinations.ts,
# app/api/generate/route.ts, app/api/edit/route.ts).
POLLINATIONS_API_KEY=

# Directory for VTracer temp input/output files. Defaults to /tmp if unset.
TEMP_DIR=/tmp

# Max concurrent pipeline jobs (in-process worker queue). See lib/pipeline/worker.ts.
MAX_CONCURRENT_JOBS=20

# Node environment
NODE_ENV=development
