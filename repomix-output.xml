// lib/utils/errors.ts

export type ErrorCode =
  | 'FILE_TOO_LARGE'
  | 'FILE_TYPE_UNSUPPORTED'
  | 'STAGE_FAILED'
  | 'AI_ERROR'
  | 'CAPACITY_EXCEEDED'
  | 'JOB_NOT_FOUND'
  | 'JOB_EXPIRED'
  | 'CANCELLED'
  | 'SVG_INVALID'
  | 'VTRACER_NOT_FOUND';

export class CurviaError extends Error {
  constructor(
    message: string,
    public readonly code: ErrorCode,
    public readonly httpStatus: number = 500,
  ) {
    super(message);
    this.name = 'CurviaError';
  }
